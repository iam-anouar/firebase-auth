
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Mi cuenta</title>

    <style>
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            font-family: Arial, sans-serif;
            background: linear-gradient(135deg, #eef2ff, #dbeafe);
            min-height: 100vh;
            display: flex;
            justify-content: center;
            align-items: center;
            padding: 20px;
        }

        .container {
            background: white;
            width: 100%;
            max-width: 550px;
            padding: 40px;
            border-radius: 16px;
            box-shadow: 0 10px 35px rgba(0, 0, 0, 0.10);
        }

        h1 {
            text-align: center;
            color: #1e293b;
            margin-bottom: 10px;
        }

        .subtitle {
            text-align: center;
            color: #64748b;
            margin-bottom: 30px;
        }

        h2 {
            color: #334155;
            font-size: 18px;
            margin-bottom: 20px;
        }

        .user-info {
            background: #f8fafc;
            border: 1px solid #e2e8f0;
            padding: 18px;
            border-radius: 10px;
            margin-bottom: 15px;
        }

        .label {
            display: block;
            color: #64748b;
            font-size: 13px;
            margin-bottom: 8px;
            font-weight: bold;
        }

        .value {
            color: #1e293b;
            font-size: 15px;
            overflow-wrap: anywhere;
        }

        .logout-button {
            display: block;
            width: 100%;
            padding: 14px;
            background: #4f46e5;
            color: white;
            text-align: center;
            text-decoration: none;
            border-radius: 8px;
            font-weight: bold;
            margin-top: 25px;
            transition: background 0.2s;
        }

        .logout-button:hover {
            background: #4338ca;
        }

        @media (max-width: 480px) {
            .container {
                padding: 25px 20px;
            }
        }
    </style>
</head>

<body>

    <main class="container">

        <h1>¡Bienvenido!</h1>
        <p class="subtitle">Has iniciado sesión correctamente.</p>

        <h2>Datos del usuario</h2>

        <div class="user-info">
            <span class="label">Correo electrónico</span>
            <p class="value"><%= user.email %></p>
        </div>

        <div class="user-info">
            <span class="label">ID del usuario (Firebase UID)</span>
            <p class="value"><%= user.uid %></p>
        </div>

        <a href="/logout" class="logout-button">
            Cerrar sesión
        </a>

    </main>

</body>
</html>
